<view class="page-root">
  <view class="nav-zone" style="height:{{navTop}}px"></view>

  <!-- 返回 -->
  <view class="login-topbar">
    <view class="login-back" hover-class="login-back-hover" bindtap="goBack">
      <icon name="chevron-left" size="20" color="#18191c" />
    </view>
  </view>

  <!-- 标题 -->
  <view class="login-head">
    <text class="login-kicker">HUAWEI ID</text>
    <text class="login-title">{{mode === 'register' ? '注册账号' : '欢迎登录'}}</text>
    <text class="login-sub">{{mode === 'register' ? '创建账号' : '使用用户名与密码登录'}}</text>
  </view>

  <!-- 登录 / 注册 切换 -->
  <view class="login-tabs">
    <view
      class="login-tab {{mode === 'login' ? 'is-active' : ''}}"
      data-mode="login"
      bindtap="switchMode"
    >登录</view>
    <view
      class="login-tab {{mode === 'register' ? 'is-active' : ''}}"
      data-mode="register"
      bindtap="switchMode"
    >注册</view>
  </view>

  <!-- 表单 -->
  <view class="login-form">
    <view class="field">
      <icon name="user-round" size="18" color="#a3a5aa" />
      <input
        class="field-input"
        type="text"
        maxlength="20"
        placeholder="用户名（3-20 位字母 / 数字 / 下划线）"
        placeholder-class="field-ph"
        value="{{username}}"
        bindinput="onUsername"
      />
    </view>

    <view class="field">
      <icon name="lock" size="18" color="#a3a5aa" />
      <input
        class="field-input"
        password="{{true}}"
        maxlength="64"
        placeholder="密码（至少 6 位）"
        placeholder-class="field-ph"
        value="{{password}}"
        bindinput="onPassword"
      />
    </view>

    <view wx:if="{{mode === 'register'}}" class="field">
      <icon name="lock" size="18" color="#a3a5aa" />
      <input
        class="field-input"
        password="{{true}}"
        maxlength="64"
        placeholder="确认密码"
        placeholder-class="field-ph"
        value="{{confirm}}"
        bindinput="onConfirm"
      />
    </view>

    <view
      class="btn-primary login-submit {{busy ? 'btn-disabled' : ''}}"
      hover-class="btn-hover"
      bindtap="submit"
    >{{busy ? '处理中…' : (mode === 'register' ? '注册并登录' : '登录')}}</view>

    <view class="login-hint">
      <text>{{mode === 'register' ? '已有账号？' : '还没有账号？'}}</text>
      <text
        class="login-hint-link"
        data-mode="{{mode === 'register' ? 'login' : 'register'}}"
        bindtap="switchMode"
      >{{mode === 'register' ? '去登录' : '立即注册'}}</text>
    </view>
  </view>

  <view class="safe-bottom-space"></view>
</view>
